{
	"name": "snake-js",
	"version": "2.0.0",
	"description": "Classic Snake game built with pure JavaScript - modernized with comprehensive testing and build tooling",
	"type": "module",
	"license": "MIT",
	"author": "jsdevspace",
	"repository": {
		"type": "git",
		"url": "https://github.com/jsdevspace/snake-js.git"
	},
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"preview": "vite preview",
		"lint": "eslint js/ app.js",
		"lint:fix": "eslint js/ app.js --fix",
		"format": "prettier --write \"**/*.{js,json,md,css,html}\"",
		"format:check": "prettier --check \"**/*.{js,json,md,css,html}\"",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:ui": "vitest --ui"
	},
	"keywords": [
		"snake",
		"game",
		"javascript",
		"canvas",
		"browser-game"
	],
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@vitest/coverage-v8": "^4.0.0",
		"@vitest/ui": "^4.0.0",
		"eslint": "^10.3.0",
		"eslint-config-prettier": "^10.1.8",
		"jsdom": "^24.0.0",
		"prettier": "^3.8.3",
		"vite": "^7.3.2",
		"vitest": "^4.0.0"
	},
	"engines": {
		"node": ">=18.0.0"
	}
}
